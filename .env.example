# 카카오 개발자 앱 키 (developers.kakao.com > 내 애플리케이션 > 앱 키)
NEXT_PUBLIC_KAKAO_JS_KEY=your-javascript-key
KAKAO_REST_API_KEY=your-rest-api-key

# Supabase (클라우드 배포 시에만 필요. 없으면 로컬 스택 기본값 사용)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리 페이지 (서버 전용 — NEXT_PUBLIC 금지)
ADMIN_KEY=your-secret-admin-passphrase
SUPABASE_SERVICE_ROLE_KEY=supabase-dashboard-settings-api-service-role

# Web Push (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=vapid-public-key
VAPID_PRIVATE_KEY=vapid-private-key
